---
import Layout from "../../layouts/Layout.astro";
import SessionCard from "../../components/SessionCard.astro";
import { EVENT_DATE, SITE_DOMAIN, SITE_TITLE } from "../../consts";
import scheduleData from "../../content/ng-baguette-conf-2027-schedule.json";
import { formatTime, type Session } from "../../utils/schedule";

type Track = "main" | "workshop";

type ScheduleSession = Omit<Session, "track"> & { track: Track };

const tracks: Array<{ id: Track; label: string }> = [
  { id: "main", label: "Conférences" },
  { id: "workshop", label: "Ateliers" },
];

const sessions = (scheduleData.sessions as ScheduleSession[]).toSorted(
  (a, b) => new Date(a.start).getTime() - new Date(b.start).getTime(),
);

const workshopSessions = sessions.filter(
  (session) => session.track === "workshop",
);

/**
 * A session belongs to the shared timeline when it runs on the main track
 * without any workshop happening at the same time: everyone attends it.
 * Everything else sits in a parallel block, one column per track.
 */
const isCommon = (session: ScheduleSession) =>
  session.track === "main" &&
  !workshopSessions.some(
    (workshop) => session.start < workshop.end && session.end > workshop.start,
  );

type Segment =
  | { kind: "common"; sessions: ScheduleSession[] }
  | {
      kind: "parallel";
      start: string;
      end: string;
      columns: Record<Track, ScheduleSession[]>;
    };

/**
 * Walk the day chronologically and group consecutive sessions into alternating
 * common / parallel segments.
 */
const segments = sessions.reduce<Segment[]>((acc, session) => {
  const current = acc.at(-1);

  if (isCommon(session)) {
    if (current?.kind === "common") {
      current.sessions.push(session);
    } else {
      acc.push({ kind: "common", sessions: [session] });
    }
    return acc;
  }

  if (current?.kind === "parallel") {
    current.columns[session.track].push(session);
    current.start =
      session.start < current.start ? session.start : current.start;
    current.end = session.end > current.end ? session.end : current.end;
    return acc;
  }

  const columns: Record<Track, ScheduleSession[]> = { main: [], workshop: [] };
  columns[session.track].push(session);
  acc.push({
    kind: "parallel",
    start: session.start,
    end: session.end,
    columns,
  });
  return acc;
}, []);

/** Indices of the parallel segments, used to wire the single tab bar to every column it controls. */
const parallelIndices = segments.flatMap((segment, index) =>
  segment.kind === "parallel" ? [index] : [],
);

const schema = {
  "@context": "https://schema.org",
  "@type": "Event",
  name: SITE_TITLE,
  startDate: EVENT_DATE,
  location: {
    "@type": "Place",
    name: "Sorbonne Université - Campus Pierre et Marie Curie",
    address: {
      "@type": "PostalAddress",
      streetAddress: "4 place Jussieu",
      addressLocality: "Paris",
      postalCode: "75005",
      addressCountry: "FR",
    },
  },
  url: `${SITE_DOMAIN}/schedule`,
  description: "Programme de la conférence NG Baguette 2027",
};
---

<Layout title="Agenda" schema={schema}>
  <main>
    <div
      class="relative bg-gradient-to-br from-primary/20 via-base-200 to-secondary/20 py-16"
    >
      <div
        class="absolute inset-0 bg-[url('/cfp-conference.jpg')] bg-cover bg-center opacity-10"
      >
      </div>
      <div class="relative max-w-screen-lg mx-auto px-4 md:px-8 text-center">
        <div
          class="inline-flex items-center gap-2 bg-primary/10 text-primary px-4 py-2 rounded-full mb-6"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
            <line x1="16" x2="16" y1="2" y2="6"></line>
            <line x1="8" x2="8" y1="2" y2="6"></line>
            <line x1="3" x2="21" y1="10" y2="10"></line>
          </svg>
          <span class="font-semibold">29 mai 2027</span>
        </div>
        <h1 class="text-4xl md:text-6xl font-bold mb-4 title-font">Agenda</h1>
        <p class="text-lg md:text-xl text-base-content/70 max-w-2xl mx-auto">
          Découvrez le programme complet de la conférence NG Baguette 2027
        </p>
        <div class="flex justify-center gap-4 mt-8">
          <div
            class="stat bg-base-100/50 backdrop-blur rounded-xl px-4 md:px-6 py-4"
          >
            <div class="stat-value text-primary text-3xl">8</div>
            <div class="stat-desc">Conférences</div>
          </div>
          <div
            class="stat bg-base-100/50 backdrop-blur rounded-xl px-4 md:px-6 py-4"
          >
            <div class="stat-value text-secondary text-3xl">2</div>
            <div class="stat-desc">Ateliers</div>
          </div>
        </div>
      </div>
    </div>

    <section
      class="max-w-screen-lg lg:max-w-screen-xl mx-auto px-4 md:px-8 py-12 space-y-6"
    >
      <div
        class="sticky z-40 lg:hidden -mx-4 md:-mx-8 px-4 md:px-8 py-3 bg-base-100/95 backdrop-blur border-b border-base-300/30"
        data-track-tabbar
      >
        <div
          class="tabs tabs-boxed grid grid-cols-2"
          role="tablist"
          aria-label="Pistes de l’agenda"
        >
          {
            tracks.map((track, index) => (
              <button
                id={`tab-${track.id}`}
                class:list={[
                  "tab tab-lg font-semibold",
                  { "tab-active": index === 0 },
                ]}
                type="button"
                role="tab"
                aria-selected={index === 0 ? "true" : "false"}
                aria-controls={parallelIndices
                  .map((segmentIndex) => `panel-${segmentIndex}-${track.id}`)
                  .join(" ")}
                tabindex={index === 0 ? 0 : -1}
                data-track-tab={track.id}
              >
                {track.label}
              </button>
            ))
          }
        </div>
      </div>

      {
        segments.map((segment, segmentIndex) =>
          segment.kind === "common" ? (
            <div class="space-y-6">
              {segment.sessions.map((session) => (
                <SessionCard session={session} />
              ))}
            </div>
          ) : (
            <div class="space-y-4">
              <div
                class="flex items-center gap-3 text-base-content/60"
                aria-hidden="true"
              >
                <span class="font-mono font-semibold">
                  {formatTime(segment.start, "fr")} –{" "}
                  {formatTime(segment.end, "fr")}
                </span>
                <span class="h-px flex-1 bg-base-content/15" />
                <span class="hidden sm:inline text-sm uppercase tracking-wide whitespace-nowrap">
                  Sessions en parallèle
                </span>
              </div>

              <div class="lg:grid lg:grid-cols-2 lg:gap-6 lg:items-stretch">
                {tracks.map((track, index) => (
                  <div
                    id={`panel-${segmentIndex}-${track.id}`}
                    class="lg:flex lg:flex-col"
                    role="tabpanel"
                    aria-labelledby={`tab-${track.id}`}
                    hidden={index !== 0}
                    data-track-panel={track.id}
                  >
                    <p
                      class="hidden lg:block font-semibold text-lg mb-4"
                      aria-hidden="true"
                    >
                      {track.label}
                    </p>
                    <div class="space-y-6 lg:flex-1 lg:flex lg:flex-col lg:gap-6 lg:space-y-0">
                      {segment.columns[track.id].map((session) => (
                        <SessionCard
                          session={session}
                          class={
                            track.id === "workshop" ? "lg:flex-1" : undefined
                          }
                        />
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          ),
        )
      }
    </section>
  </main>
</Layout>

<script>
  const tabs = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-track-tab]"),
  );
  const panels = Array.from(
    document.querySelectorAll<HTMLElement>("[data-track-panel]"),
  );

  /**
   * The tab bar sticks below the site header, whose height depends on its
   * content, so measure it rather than hard-coding an offset.
   */
  const header = document.querySelector("header");
  const tabBar = document.querySelector<HTMLElement>("[data-track-tabbar]");

  if (header && tabBar) {
    const syncStickyOffset = () =>
      tabBar.style.setProperty(
        "top",
        `${header.getBoundingClientRect().height}px`,
      );

    syncStickyOffset();
    new ResizeObserver(syncStickyOffset).observe(header);
  }

  /** A single tab bar drives the columns of every parallel block at once. */
  function activateTrack(track: string) {
    for (const tab of tabs) {
      const isActive = tab.dataset.trackTab === track;
      tab.classList.toggle("tab-active", isActive);
      tab.setAttribute("aria-selected", String(isActive));
      tab.tabIndex = isActive ? 0 : -1;
    }

    for (const panel of panels) {
      panel.hidden = panel.dataset.trackPanel !== track;
    }
  }

  for (const tab of tabs) {
    tab.addEventListener("click", () => activateTrack(tab.dataset.trackTab!));
    tab.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;

      event.preventDefault();
      const direction = event.key === "ArrowRight" ? 1 : -1;
      const index = tabs.indexOf(tab);
      const nextTab = tabs[(index + direction + tabs.length) % tabs.length];
      activateTrack(nextTab.dataset.trackTab!);
      nextTab.focus();
    });
  }
</script>

<style>
  .title-font {
    font-family: "Bangers", sans-serif;
  }

  /* On desktop both tracks are shown side by side, so the tab selection
     (which sets the `hidden` attribute) must not hide a column. */
  @media (min-width: 1024px) {
    [data-track-panel][hidden] {
      display: flex;
    }
  }
</style>
<style is:global>
  .prose p {
    margin-bottom: 1em;
  }
  .prose blockquote {
    border-left: 4px solid hsl(var(--p));
    padding-left: 1em;
    margin: 1em 0;
    font-style: italic;
  }
</style>
